{
  "rewrites": [
    {
      "source": "/api/groq/:path*",
      "destination": "https://api.groq.com/openai/v1/:path*"
    },
    {
      "source": "/api/tmdb/:path*",
      "destination": "https://api.themoviedb.org/3/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
