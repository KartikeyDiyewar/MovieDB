# TMDB API Credentials
# Get your API key and Access Token from https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_api_key_here
VITE_TMDB_ACCESS_TOKEN=your_v4_read_access_token_here

# Groq AI Cinema Concierge (Llama 3 / Qwen high-speed AI recommendations)
# Get your free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here

# Monetization & Affiliate Partners (Optional)
VITE_AMAZON_AFFILIATE_TAG=your_amazon_tag_21
VITE_VPN_AFFILIATE_URL=https://nordvpn.com/your_referral
VITE_TELEGRAM_COMMUNITY_URL=https://t.me/your_channel
